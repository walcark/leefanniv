# Copy to ~/.config/leefanniv/server.env (chmod 600). Read by the systemd user unit.
# Bind on the WireGuard address only: the VPN is the access control.
LEEFANNIV_HOST=10.8.0.1
LEEFANNIV_PORT=8003
LEEFANNIV_ALLOWED_HOSTS=10.8.0.1,127.0.0.1,localhost
LEEFANNIV_DEBUG=0
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
LEEFANNIV_SECRET_KEY=change-me
LEEFANNIV_DB=/home/ubuntu/.local/share/leefanniv/db.sqlite3
