# systemd *user* unit. Install on the server with:
#   cp deploy/leefanniv.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now leefanniv
#   sudo loginctl enable-linger $USER   # keep it running after logout
[Unit]
Description=leefanniv, party tournament scoring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/leefanniv
EnvironmentFile=%h/.config/leefanniv/server.env
ExecStart=%h/.pixi/bin/pixi run serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
